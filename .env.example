# Copy to .env for local use. On Render set these in Dashboard > Environment (do NOT commit real values).
PORT=3000
ADMIN_PASSWORD=Chibuzor

# Your receiving wallet addresses (leave blank to hide that coin at checkout)
WALLET_BTC=
WALLET_ETH=
WALLET_SOL=
WALLET_USDT_TRC20=

# Optional: every new order / payment submission is POSTed here as JSON (Slack, Discord, Zapier, Make)
ORDER_WEBHOOK_URL=
# Optional: folder for orders.json and products.json (set to a Render Disk mount, e.g. /var/data)
DATA_DIR=
